#!/usr/bin/env python3
"""Passively monitor a child command and expose its state to Telegraf."""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path


def read_process_table():
    """Return a mapping of pid to (state, ppid) for all readable /proc entries."""
    table = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text()
        except OSError:
            continue
        # The command name is enclosed in parentheses and may itself contain spaces.
        fields = stat[stat.rfind(")") + 2 :].split()
        if len(fields) < 2:
            continue
        try:
            table[int(entry.name)] = (fields[0], int(fields[1]))
        except ValueError:
            continue
    return table


def process_tree(table, root_pid):
    """Return the set of root_pid and all of its descendants."""
    children = {}
    for pid, (_, ppid) in table.items():
        children.setdefault(ppid, set()).add(pid)
    tree = {root_pid}
    pending = [root_pid]
    while pending:
        for child_pid in children.get(pending.pop(), ()):
            if child_pid not in tree:
                tree.add(child_pid)
                pending.append(child_pid)
    return tree


def safe_filename(name):
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", name).strip("._") or "watchdog"


def write_state(state_dir, name, state):
    state_dir.mkdir(parents=True, exist_ok=True)
    destination = state_dir / f"{safe_filename(name)}.json"
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{destination.name}.", dir=state_dir)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(state, output, sort_keys=True)
            output.write("\n")
        os.chmod(temporary_name, 0o644)
        os.replace(temporary_name, destination)
    finally:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass


def severity(d_state_seconds, warning_seconds, critical_seconds):
    if d_state_seconds >= critical_seconds:
        return 2
    if d_state_seconds >= warning_seconds:
        return 1
    return 0


def run(arguments):
    started_at = time.time()
    state_dir = Path(arguments.state_dir)
    command = arguments.command

    try:
        child = subprocess.Popen(command)
    except OSError as error:
        write_state(
            state_dir,
            arguments.name,
            {
                "name": arguments.name,
                "state": "exited",
                "running": False,
                "exit_code": 127,
                "error": str(error),
                "started_at": started_at,
                "updated_at": time.time(),
                "elapsed_seconds": 0,
                "d_state_seconds": 0,
                "severity": 3,
            },
        )
        print(f"Unable to start {command[0]}: {error}", file=sys.stderr)
        return 127

    # A process stuck on uninterruptible I/O is assumed to stay there, so the
    # timer starts at the first observed D-state and is never reset.
    d_started_at = None
    d_state_seconds = 0
    while True:
        now = time.time()
        table = read_process_table()
        tree = process_tree(table, child.pid)
        d_pids = sorted(pid for pid in tree if table.get(pid, ("R",))[0] == "D")
        if d_pids:
            if d_started_at is None:
                d_started_at = now
            d_state_seconds = int(now - d_started_at)
        else:
            d_state_seconds = 0

        write_state(
            state_dir,
            arguments.name,
            {
                "name": arguments.name,
                "pid": child.pid,
                "state": (table.get(child.pid, ("unknown",))[0] or "unknown").lower(),
                "running": True,
                "started_at": started_at,
                "updated_at": now,
                "elapsed_seconds": int(now - started_at),
                "d_state_seconds": d_state_seconds,
                "d_state_pids": d_pids,
                "severity": severity(
                    d_state_seconds,
                    arguments.warning_d_seconds,
                    arguments.critical_d_seconds,
                ),
            },
        )
        try:
            exit_code = child.wait(timeout=arguments.interval)
            break
        except subprocess.TimeoutExpired:
            pass

    exited_at = time.time()
    write_state(
        state_dir,
        arguments.name,
        {
            "name": arguments.name,
            "pid": child.pid,
            "state": "exited",
            "running": False,
            "exit_code": exit_code,
            "started_at": started_at,
            "updated_at": exited_at,
            "elapsed_seconds": int(exited_at - started_at),
            "d_state_seconds": d_state_seconds,
            "severity": 0,
        },
    )
    return exit_code


def escape_tag(value):
    return str(value).replace("\\", "\\\\").replace(",", "\\,").replace("=", "\\=").replace(" ", "\\ ")


def emit_point(name, state, fields):
    tags = f"name={escape_tag(name)},state={escape_tag(state)}"
    line_fields = ",".join(f"{key}={value}i" for key, value in fields.items())
    print(f"script_watchdog,{tags} {line_fields}")


def report(arguments):
    state_dir = Path(arguments.state_dir)
    now = time.time()

    reported = set()
    if state_dir.exists():
        for path in sorted(state_dir.glob("*.json")):
            try:
                state = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as error:
                print(f"Unable to read watchdog state {path}: {error}", file=sys.stderr)
                continue

            fields = {
                "running": int(bool(state.get("running", False))),
                "severity": int(state.get("severity", 0)),
                "elapsed_seconds": int(state.get("elapsed_seconds", 0)),
                "d_state_seconds": int(state.get("d_state_seconds", 0)),
                "state_age_seconds": max(0, int(now - state.get("updated_at", now))),
            }
            for optional_field in ("pid", "exit_code"):
                if optional_field in state:
                    fields[optional_field] = int(state[optional_field])
            emit_point(state.get("name", path.stem), state.get("state", "unknown"), fields)
            reported.add(path.stem)

    # Scripts without a state file (never run, or state lost on reboot) are
    # reported as okay so that dashboards always have a data point.
    for name in arguments.names:
        if safe_filename(name) in reported:
            continue
        emit_point(
            name,
            "absent",
            {
                "running": 0,
                "severity": 0,
                "elapsed_seconds": 0,
                "d_state_seconds": 0,
                "state_age_seconds": 0,
            },
        )
    return 0


def parser():
    command_parser = argparse.ArgumentParser(description=__doc__)
    subcommands = command_parser.add_subparsers(dest="subcommand", required=True)

    run_parser = subcommands.add_parser("run", help="run and passively observe a command")
    run_parser.add_argument("--name", required=True, help="metric and state-file name")
    run_parser.add_argument("--state-dir", default="/run/script-watchdog")
    run_parser.add_argument("--interval", type=float, default=10.0)
    run_parser.add_argument("--warning-d-seconds", type=int, default=60)
    run_parser.add_argument("--critical-d-seconds", type=int, default=300)
    run_parser.add_argument("command", nargs=argparse.REMAINDER)

    report_parser = subcommands.add_parser("report", help="emit all local state as Influx line protocol")
    report_parser.add_argument("--state-dir", default="/run/script-watchdog")
    report_parser.add_argument(
        "--names",
        default="",
        help="comma-separated script names to report as okay when no state file exists",
    )
    return command_parser


def main():
    arguments = parser().parse_args()
    if arguments.subcommand == "run":
        command = arguments.command
        if command and command[0] == "--":
            command = command[1:]
        if not command:
            parser().error("run requires a command after --")
        arguments.command = command
        if arguments.interval <= 0:
            parser().error("--interval must be greater than zero")
        if arguments.warning_d_seconds < 0 or arguments.critical_d_seconds < arguments.warning_d_seconds:
            parser().error("D-state thresholds must be non-negative and ordered")
        arguments.names = []
        return run(arguments)
    arguments.names = [name.strip() for name in arguments.names.split(",") if name.strip()]
    return report(arguments)


if __name__ == "__main__":
    sys.exit(main())
